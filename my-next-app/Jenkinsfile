pipeline {
    agent {
        docker {
            image 'node:18'  // Using Node.js 18 image
            args '-v /var/run/docker.sock:/var/run/docker.sock'  // Map Docker socket to allow Docker commands inside
        }
    }

    environment {
        IMAGE_NAME = "myapp:latest"
        CONTAINER_NAME = "myapp-container"
    }

    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'boo', url: 'https://github.com/boojanashree-g/pipeline_test.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'  // Install dependencies
                echo 'Dependencies installed successfully!'
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build || echo "No build step for Node.js"'
                echo 'Building the application...'
            }
        }

        stage('Test') {
            steps {
                sh 'npm test || echo "No tests defined"'
                echo 'Running tests...'
            }
        }

        stage('Deploy') {
            steps {
                script {
                    // Install Docker CLI in the Node container if needed
                    sh '''
                    apt-get update
                    apt-get install -y apt-transport-https ca-certificates curl gnupg lsb-release
                    curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg
                    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/debian $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null
                    apt-get update
                    apt-get install -y docker-ce-cli
                    '''

                    // Build Docker image
                    sh "docker build -t $IMAGE_NAME ."

                    // Stop and remove existing container
                    sh "docker stop $CONTAINER_NAME || true && docker rm $CONTAINER_NAME || true"

                    // Run new container
                    sh "docker run -d -p 8080:80 --name $CONTAINER_NAME --restart always $IMAGE_NAME"

                    echo "Application deployed in Docker!"
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline executed successfully!"
        }
        failure {
            echo "Pipeline failed!"
        }
    }
}