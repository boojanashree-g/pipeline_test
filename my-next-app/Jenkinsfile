pipeline {
    agent any  // Use any available agent (instead of `docker`)

    environment {
        IMAGE_NAME = "myapp:latest"
        CONTAINER_NAME = "myapp-container"
    }

    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'boo', url: 'https://github.com/boojanashree-g/pipeline_test.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Dependencies installed successfully!'
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build || echo "No build step for Node.js"'
                echo 'Building the application...'
            }
        }

        stage('Test') {
            steps {
                sh 'npm test || echo "No tests defined"'
                echo 'Running tests...'
            }
        }

        stage('Deploy') {
            steps {
                script {
                    // Build Docker image
                    sh "docker build -t $IMAGE_NAME ."

                    // Stop and remove existing container
                    sh "docker stop $CONTAINER_NAME || true && docker rm $CONTAINER_NAME || true"

                    // Run new container
                    sh "docker run -d -p 8080:80 --name $CONTAINER_NAME --restart always $IMAGE_NAME"

                    echo "Application deployed in Docker!"
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline executed successfully!"
        }
        failure {
            echo "Pipeline failed!"
        }
    }
}
