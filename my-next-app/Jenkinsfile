pipeline {
    agent {
        docker {
            image 'node:18'  // Use Node.js 18 Docker image
        }
    }

    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'boo', url: 'https://github.com/boojanashree-g/pipeline_test.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
                echo 'Dependencies installed successfully!'
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build || echo "No build step for Node.js"'
                echo 'Building the application...'
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
                sh 'npm test || echo "No tests defined"'
            }
        }

        stage('Deploy') {
            steps {
                script {
                    def imageName = "myapp:latest"

                    // Build Docker Image
                    sh "docker build -t $imageName ."

                    // Stop and remove old container
                    sh "docker stop myapp-container || true && docker rm myapp-container || true"

                    // Run new Docker container
                    sh "docker run -d -p 8080:80 --name myapp-container --restart always $imageName"

                    echo "Application deployed locally in Docker!"
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline executed successfully!"
        }
        failure {
            echo "Pipeline failed!"
        }
    }
}
